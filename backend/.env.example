# Server
SERVER_PORT=8080

# JWT
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRES_IN=24h

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=sre_user
DB_PASSWORD=your-db-password
DB_NAME=bigdata_sre

# Encryption (REQUIRED for DingTalk secrets)
# Generate a 32-character random string for encryption key
# Example: openssl rand -hex 16
ENCRYPTION_KEY=your-32-char-encryption-key-here

# Hadoop
HADOOP_NAMENODE_URL=http://localhost:9870
HADOOP_YARN_URL=http://localhost:8088
HADOOP_USER=hadoop

# Spark
SPARK_HISTORY_URL=http://localhost:18080

# Ambari
AMBARI_URL=http://localhost:8080
AMBARI_USERNAME=admin
AMBARI_PASSWORD=admin
AMBARI_CLUSTER_NAME=

# GLM (智谱 AI)
GLM_ENABLED=true
GLM_API_KEY=your-glm-api-key
GLM_API_URL=http://llmapi.ld-hadoop.com/v1/chat/completions
GLM_MODEL=glm-5